  step=2,dige:1902b2d06d07af4c,desc:seed three sibling cogs with distinct doses
  step=3,dige:13185f216eadbf34,desc:mint A:Vyto beside the run and commission it on the three cogs
  step=4,dige:4f46fc076cb3bca6,desc:bump a grapple — the first stir expresses and solves the cut
